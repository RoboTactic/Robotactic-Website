{
  "name": "robotactic-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the RoboTactic website.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "schema": "node scripts/applySchema.js",
    "db:migrate": "node scripts/migrateDatabase.js",
    "seed": "node scripts/seedDatabase.js",
    "seed:publish": "node scripts/seedDatabase.js --publish",
    "seed:full": "node scripts/seedDatabase.js --full --publish",
    "admin:create": "node scripts/createAdmin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^1.14.10"
  }
}
