# Public browser configuration only. Never put secrets in VITE_* values.
VITE_API_BASE_URL=/api

# Cloudflare build settings; these are not database credentials.
HYPERDRIVE_ID=
CORS_ORIGINS=
SUPABASE_URL=
# Enable only after adding SUPABASE_SECRET_KEY as a Worker secret.
ENABLE_IMAGE_UPLOADS=false
# Set true only when Workers Paid is active (recommended for admin password hashing).
WORKERS_PAID_PLAN=false
